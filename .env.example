# 로컬 실행용 예시입니다. 이 파일 자체에는 실제 비밀값을 넣지 마세요.
# 운영값은 Cloudflare Worker secret과 GitHub Actions secret으로 등록합니다.
ADMIN_PASSWORD=change-this-admin-password
# 세션 위조 방지를 위해 예측 불가능한 32자 이상 값을 사용하세요.
SESSION_SECRET=change-this-to-a-long-random-secret
# 선택: 기본 교육기관 도메인 외에 허용할 공개 PDF 호스트를 쉼표로 구분합니다.
PUBLIC_PDF_ALLOWED_HOSTS=
