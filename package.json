    "pdfjs-dist": "^5.4.624",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "vinext": "1.0.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260929.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
